{
  "name": "@hotel/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --exec \"node --loader ts-node/esm src/main.ts\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "echo \"No lint configured yet\"",
    "notion:bootstrap": "node --loader ts-node/esm src/scripts/bootstrapNotion.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@notionhq/client": "^2.2.15",
    "fastify": "^5.0.0",
    "googleapis": "^144.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.14",
    "typescript": "^5.5.4",
    "ts-node": "^10.9.2",
    "nodemon": "^3.1.4"
  }
}
